# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Alpaca — paper trading (safe default)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets   # switch to https://api.alpaca.markets for live

# Trading limits
MAX_POSITION_USD=500        # max dollars per trade
MAX_TOTAL_POSITIONS=10      # max open positions at once
POLL_INTERVAL_SECONDS=300   # 5 minutes
