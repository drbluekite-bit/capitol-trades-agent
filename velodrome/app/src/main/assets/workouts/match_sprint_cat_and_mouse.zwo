<workout_file>
  <author>Velodrome Ghost</author>
  <name>Match Sprint - Cat and Mouse</name>
  <description>Classic 3-lap (750 m) match sprint. The ghost soft-pedals and watches you, winds it up on lap 2, then goes flat out for the line. Sit on its wheel and come round it in the last 200 m.</description>
  <sportType>bike</sportType>
  <tags>
    <tag name="TRACK"/>
    <tag name="SPRINT"/>
  </tags>
  <workout>
    <SteadyState Duration="40" Power="0.55" Cadence="80">
      <textevent timeoffset="1" message="Cat and mouse - watch the ghost"/>
    </SteadyState>
    <Ramp Duration="20" PowerLow="0.60" PowerHigh="1.00" Cadence="95">
      <textevent timeoffset="0" message="Ghost is winding it up"/>
    </Ramp>
    <SteadyState Duration="10" Power="1.20" Cadence="105"/>
    <MaxEffort Duration="18">
      <textevent timeoffset="0" message="Ghost has gone! Chase!"/>
    </MaxEffort>
    <Cooldown Duration="60" PowerLow="0.70" PowerHigh="0.40" Cadence="85"/>
  </workout>
</workout_file>
