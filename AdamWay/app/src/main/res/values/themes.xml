<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Adam Way is always black-background / white-text, regardless of system theme. -->
    <style name="Theme.AdamWay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/adam_way_black</item>
        <item name="android:statusBarColor">@color/adam_way_black</item>
        <item name="android:navigationBarColor">@color/adam_way_black</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
